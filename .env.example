# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Email OTP verification (required for student registration)
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Use a sender/domain verified in your Resend account, e.g. "Touch Grass <verify@yourdomain.com>"
EMAIL_FROM=
# Generate a long random secret; keep it stable across deployments.
SESSION_SECRET=

# AI image verification: local (default) or cloud
OLLAMA_MODE=local
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llava:latest
# For cloud mode, create an API key at https://ollama.com/settings/keys
# OLLAMA_MODE=cloud
# OLLAMA_API_KEY=
# OLLAMA_CLOUD_BASE_URL=https://ollama.com/api
# OLLAMA_MODEL=kimi-k3:cloud
OLLAMA_TIMEOUT_MS=45000

# Admin API bearer secret (generate a long, random value)
ADMIN_SECRET=

# Cloudflare Tunnel token is configured in the Cloudflare dashboard.
# Do not put tunnel tokens in this file or commit them.
# Local tunnel example: cloudflared tunnel --url http://localhost:3000
