# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Student registration accepts only the official JUET domain by default.
# Email validation currently checks the format/domain; it does not send an email OTP.
# Optional mail delivery, if you later add verification/notifications:
# RESEND_API_KEY=
# EMAIL_FROM=

# AI image verification: local (default) or cloud
OLLAMA_MODE=local
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llava:latest
# For cloud mode, create an API key at https://ollama.com/settings/keys
# OLLAMA_MODE=cloud
# OLLAMA_API_KEY=
# OLLAMA_CLOUD_BASE_URL=https://ollama.com/api
OLLAMA_TIMEOUT_MS=45000

# Admin API bearer secret (generate a long, random value)
ADMIN_SECRET=

# Cloudflare Tunnel token is configured in the Cloudflare dashboard.
# Do not put tunnel tokens in this file or commit them.
# Local tunnel example: cloudflared tunnel --url http://localhost:3000
